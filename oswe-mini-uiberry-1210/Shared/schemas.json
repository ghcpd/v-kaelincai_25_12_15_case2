{
  "request_schema": {
    "type": "object",
    "required": ["request_id", "students"],
    "properties": {
      "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9_\-]+$"},
      "students": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "score"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "score": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      }
    }
  },

  "ranking_event": {
    "type": "object",
    "required": ["type", "request_id", "payload"],
    "properties": {
      "type": {"type": "string"},
      "request_id": {"type": "string"},
      "payload": {"type": "array"}
    }
  }
}
